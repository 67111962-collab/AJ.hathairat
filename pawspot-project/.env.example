# Copy this file to .env and fill in the values.

# --- PostgreSQL (view the data in pgAdmin) ---
# Password = the one you chose when installing PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pawspot
# Or use one connection string instead (e.g. a hosted database):
# DATABASE_URL=postgres://user:password@host:5432/pawspot

# Secret for signing login tokens - use a long random string in production.
JWT_SECRET=

PORT=3000

# Public address of the site (no trailing slash). Social login callback URLs are built from it:
#   <PUBLIC_URL>/api/auth/oauth/google/callback
#   <PUBLIC_URL>/api/auth/oauth/line/callback
PUBLIC_URL=http://localhost:3000

# --- Social login (leave empty to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Add "email" only after LINE approves email permission for your channel
# LINE_SCOPE=profile openid email

# Create demo accounts (admin/123, user/1234) and sample posts when the DB is empty.
SEED_DEMO=true
